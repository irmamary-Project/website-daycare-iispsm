# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# Upload endpoint (cPanel hosting)
NEXT_PUBLIC_UPLOAD_URL=https://your-domain.com/uploads/upload.php
UPLOAD_API_KEY=your-secret-api-key

# Gallery/facilities images live on a SEPARATE Supabase storage project than the
# logo (SUPABASE_STORAGE_URL). Override only if they are migrated to the same project.
NEXT_PUBLIC_GALLERY_STORAGE_URL=

# CCTV stream URLs — SERVER-ONLY. Do NOT prefix with NEXT_PUBLIC_.
# These are read only inside app/api/cctv/stream-url/route.ts and are
# never bundled into client-side JS or committed to git.
CCTV_STREAM_URL_1=https://your-stream-host:port/stream401/file.m3u8
CCTV_STREAM_URL_2=https://your-stream-host:port/stream402/file.m3u8
